def word_frequencies(text):
    words = text.lower().split()
    result = {}
    for word in words:
        if word in result:
            result[word] += 1
        else:
            result[word] = 1
    return result

print(word_frequencies("hello world hello"))
3)
def top_k(items, k):
    result = {}
    for i in items:
        if i in result:
            result[i] += 1
        else:
            result[i] = 1
    sorted_items = sorted(result, key=result.get, reverse=True)
    return sorted_items[:k]

print(top_k([1, 2, 2, 3, 3, 3], 2))
4)
def transpose(matrix):
    result = []
    for i in range(len(matrix[0])):
        row = []
        for j in range(len(matrix)):
            row.append(matrix[j][i])
        result.append(row)
    return result

print(transpose([[1, 2, 3], [4, 5, 6]]))
5)
def invert(dictionary):
    result = {}
    for key in dictionary:
        value = dictionary[key]
        result[value] = key
    return result

print(invert({"a": 1, "b": 2}))
